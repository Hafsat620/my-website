/* General Setup */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    line-height: 1.6;
    color: #333;
    background-color: #f9f9f9;
}

/* Navbar Layout */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #2c3e50;
    padding: 1rem 2rem;
    color: white;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 1.5rem;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.nav-links a:hover {
    color: #f39c12;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 3rem 1rem;
    background: #ffffff;
}

.hero-image {
    max-width: 100%;
    height: auto;
    max-height: 350px;
    border-radius: 8px;
    object-fit: cover;
}

.hero h1 {
    margin: 1rem 0;
    font-size: 2.2rem;
}

#start-button {
    padding: 0.75rem 1.5rem;
    background-color: #e67e22;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
}

#start-button:hover {
    background-color: #d35400;
}

/* Services Cards */
.services {
    padding: 3rem 2rem;
    text-align: center;
}

.service-container {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
}

.service-card {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 280px;
}

/* Form Layout */
.contact {
    max-width: 500px;
    margin: 2rem auto;
    padding: 2rem;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

#contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    text-align: left;
}

#contact-form input,
#contact-form textarea {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #ccc;
    border-radius: 4px;
}

#contact-form button {
    padding: 0.75rem;
    background-color: #27ae60;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
}

#contact-form button:hover {
    background-color: #219150;
}

/* Footer */
footer {
    text-align: center;
    padding: 1.5rem;
    background-color: #2c3e50;
    color: white;
    margin-top: 2rem;
}